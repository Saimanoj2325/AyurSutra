rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAssignedPractitioner(patientId) {
      return exists(/databases/$(database)/documents/patients/$(patientId)) &&
             get(/databases/$(database)/documents/patients/$(patientId)).data.allowedPractitionerIds is list &&
             request.auth.uid in get(/databases/$(database)/documents/patients/$(patientId)).data.allowedPractitionerIds;
    }
    
    // =============================================
    // User index collection — minimal data per user
    // =============================================
    match /users/{userId} {
      // Users can read their own index
      allow read: if isAuthenticated() && isOwner(userId);
      
      // Users can create their own index during signup
      allow create: if isAuthenticated() && isOwner(userId)
                    && request.resource.data.keys().hasAll(['uid', 'email', 'name', 'userType'])
                    && request.resource.data.uid == userId;
      
      // Users can update their own index (name changes only, cannot change role)
      allow update: if isAuthenticated() && isOwner(userId)
                    && !('uid' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('email' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('userType' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('createdAt' in request.resource.data.diff(resource.data).affectedKeys());
    }
    
    // =============================================
    // Patient-specific data collection
    // =============================================
    match /patients/{patientId} {
      // Patients can read/create/update their own profile
      allow read, create: if isAuthenticated() && isOwner(patientId);
      allow update: if isAuthenticated() && isOwner(patientId);
      
      // Practitioners can read patient profiles they are assigned to
      allow read: if isAuthenticated()
                  && resource.data.allowedPractitionerIds is list
                  && request.auth.uid in resource.data.allowedPractitionerIds;
      
      // Practitioners can update assigned patients (limited fields)
      allow update: if isAuthenticated()
                    && resource.data.allowedPractitionerIds is list
                    && request.auth.uid in resource.data.allowedPractitionerIds
                    && !('uid' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('email' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('createdAt' in request.resource.data.diff(resource.data).affectedKeys());
      
      // Allow listing patients ONLY for practitioners who are assigned to them (filtered query)
      allow list: if isAuthenticated() && (
        isOwner(patientId) || 
        (resource != null && resource.data.allowedPractitionerIds is list && request.auth.uid in resource.data.allowedPractitionerIds)
      );
    }
    
    // =============================================
    // Practitioner-specific data collection
    // =============================================
    match /practitioners/{practitionerId} {
      // Practitioners can read/create/update their own profile
      allow read: if isAuthenticated() && isOwner(practitionerId);
      allow create: if isAuthenticated() && isOwner(practitionerId);
      allow update: if isAuthenticated() && isOwner(practitionerId);
      
      // Allow listing all practitioners (patients need to see available practitioners)
      allow list: if isAuthenticated();
    }
    
    // =============================================
    // Sessions collection
    // =============================================
    match /sessions/{sessionId} {
      // Anyone involved in the session can read/update it
      allow read: if isAuthenticated()
                  && (request.auth.uid == resource.data.patientId
                      || request.auth.uid == resource.data.practitionerId);
      
      allow update: if isAuthenticated()
                    && (request.auth.uid == resource.data.patientId
                        || request.auth.uid == resource.data.practitionerId);
                          
      // Allow creation by either patient or practitioner involved
      allow create: if isAuthenticated()
                    && (request.auth.uid == request.resource.data.patientId
                        || request.auth.uid == request.resource.data.practitionerId);
      
      // Allow listing sessions if filtering by patientId or practitionerId
      allow list: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.practitionerId
      );
      
      // Allow deletion by involved parties
      allow delete: if isAuthenticated()
                    && (request.auth.uid == resource.data.patientId
                        || request.auth.uid == resource.data.practitionerId);
    }
    
    // =============================================
    // Notifications collection
    // =============================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
      allow list: if isAuthenticated() && (
        isOwner(resource.data.userId) || isOwner(request.resource.data.userId)
      );
    }
    
    // =============================================
    // Feedback collection
    // =============================================
    match /feedback/{feedbackId} {
      allow read: if isAuthenticated()
                  && (request.auth.uid == resource.data.patientId
                      || request.auth.uid == resource.data.practitionerId);
      
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.patientId;
      
      allow update: if isAuthenticated()
                    && (request.auth.uid == resource.data.patientId
                        || request.auth.uid == resource.data.practitionerId);
      
      allow list: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.practitionerId
      );
    }
    
    // =============================================
    // Messages collection
    // =============================================
    match /messages/{messageId} {
      allow read: if isAuthenticated()
                  && (isOwner(resource.data.senderId)
                      || isOwner(resource.data.receiverId));
      
      allow update: if isAuthenticated()
                    && (isOwner(resource.data.senderId)
                        || isOwner(resource.data.receiverId));
      
      allow create: if isAuthenticated() && isOwner(request.resource.data.senderId);
      
      allow list: if isAuthenticated() && (
        isOwner(resource.data.senderId) || isOwner(resource.data.receiverId)
      );
    }
    
    // =============================================
    // Progress collection
    // =============================================
    match /progress/{progressId} {
      allow read: if isAuthenticated() && (isOwner(progressId) || isAssignedPractitioner(progressId));
      allow create: if isAuthenticated() && isOwner(progressId);
      allow update: if isAuthenticated() && (isOwner(progressId) || isAssignedPractitioner(progressId));
      allow list: if isAuthenticated() && (isOwner(progressId) || isAssignedPractitioner(progressId));
    }
    
    // =============================================
    // Notes collection
    // =============================================
    match /notes/{noteId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId || 
        request.auth.uid == resource.data.practitionerId
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.practitionerId
      );
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.practitionerId
      );
      allow list: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId || 
        request.auth.uid == resource.data.practitionerId
      );
    }
    
    // =============================================
    // Analytics collection
    // =============================================
    match /analytics/{analyticsId} {
      // Analytics should only be read/write by practitioners
      allow read, write: if isAuthenticated() && exists(/databases/$(database)/documents/practitioners/$(request.auth.uid));
    }
    
    // =============================================
    // Recipes collection
    // =============================================
    match /recipes/{recipeId} {
      allow read: if isAuthenticated();
      // Only practitioners can manage recipes
      allow create, update, delete: if isAuthenticated() && exists(/databases/$(database)/documents/practitioners/$(request.auth.uid));
    }
    
    // =============================================
    // Documents collection
    // =============================================
    match /documents/{documentId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) || isAssignedPractitioner(resource.data.userId)
      );
      allow create: if isAuthenticated() && (
        isOwner(request.resource.data.userId) || isAssignedPractitioner(request.resource.data.userId)
      );
      allow update, delete: if isAuthenticated() && (
        isOwner(resource.data.userId) || isAssignedPractitioner(resource.data.userId)
      );
      allow list: if isAuthenticated() && (
        isOwner(resource.data.userId) || isAssignedPractitioner(resource.data.userId)
      );
    }
    
    // =============================================
    // Tasks collection
    // =============================================
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) || isAssignedPractitioner(resource.data.userId)
      );
      allow create: if isAuthenticated() && (
        isOwner(request.resource.data.userId) || isAssignedPractitioner(request.resource.data.userId)
      );
      allow update, delete: if isAuthenticated() && (
        isOwner(resource.data.userId) || isAssignedPractitioner(resource.data.userId)
      );
      allow list: if isAuthenticated() && (
        isOwner(resource.data.userId) || isAssignedPractitioner(resource.data.userId)
      );
    }
    
    // Deny all other requests
    match /{document=**} {
      allow read, write: if false;
    }
  }
}